# Keep source and review artifacts byte-stable across Windows and Linux builds.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.bat text eol=crlf

# PostgreSQL migration hashes intentionally bind their existing raw bytes.
/drizzle/pg/*.sql -text
/drizzle/pg/meta/*.json -text
/drizzle/pg/_schema-baseline.json -text

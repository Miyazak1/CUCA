# CUAC staging environment template.
# Copy values into your Alibaba Cloud staging secret manager or deployment environment.
# Do not put real credentials in this file.

NODE_ENV=production
CUAC_ENV=staging
CUAC_HTTP_HOST=0.0.0.0
PORT=3000
# Supervisor termination grace must exceed this total application drain budget.
CUAC_HTTP_SHUTDOWN_TIMEOUT_MS=30000
CUAC_MIGRATION_TARGET_ENV=staging
# Inject exact values from the protected release record; these are identifiers, not secrets.
CUAC_RELEASE_COMMIT_SHA=replace-with-40-character-release-commit-sha
CUAC_RELEASE_IMAGE_DIGEST=sha256:replace-with-64-character-image-digest
CUAC_MIGRATION_MANIFEST_SHA256=replace-with-64-character-migration-manifest-digest

# Alibaba Cloud runtime
ALIBABA_CLOUD_REGION=cn-shanghai
CUAC_APP_RUNTIME=ecs-container
CUAC_SECRET_MANAGER=aliyun-kms
ALIBABA_CLOUD_KMS_KEY_ID=replace-with-staging-kms-key-id

# PostgreSQL / Alibaba Cloud RDS
DATABASE_URL=postgres://cuac_staging_user:replace-password@replace-staging-rds-endpoint:5432/cuac_staging
PGSSLMODE=verify-full
CUAC_PRIVATE_NETWORK_APPROVED=false

# Auth
CUAC_SESSION_SECRET=replace-with-at-least-32-random-characters
CUAC_AUTH_RATE_LIMIT_ENFORCED=true
CUAC_AUTH_RATE_LIMIT_BACKEND=gateway
# Keep disabled until supervised staging verification/reset delivery acceptance is complete.
CUAC_AUTH_EMAIL_DELIVERY_PROVIDER=disabled
CUAC_AUTH_EMAIL_FROM=no-reply@staging.example.com
# Exact origin for API write protection and email links. No path, query or credentials.
CUAC_PUBLIC_APP_URL=https://staging.example.com
CUAC_AUTH_EMAIL_VERIFICATION_PATH=/auth/verify-email
CUAC_AUTH_PASSWORD_RESET_PATH=/auth/reset-password
# Required only when CUAC_AUTH_EMAIL_DELIVERY_PROVIDER=aliyun-directmail-smtp.
CUAC_AUTH_EMAIL_SMTP_REGION=cn-hangzhou
CUAC_AUTH_EMAIL_SMTP_USERNAME=no-reply@staging.example.com
CUAC_AUTH_EMAIL_SMTP_PASSWORD=
CUAC_AUTH_EMAIL_OUTBOX_ACTIVE_KEY_ID=
CUAC_AUTH_EMAIL_OUTBOX_KEYS_JSON=
CUAC_AUTH_EMAIL_WORKER_POLL_MS=1000
CUAC_AUTH_EMAIL_WORKER_RECOVERY_MS=60000
CUAC_AUTH_EMAIL_WORKER_SUPERVISED=false
CUAC_AUTH_EMAIL_STAGING_ACCEPTED=false

# Account-scoped business notifications. In-app delivery works without this provider.
# Keep external email disabled until supervised staging delivery/bounce acceptance is complete.
CUAC_NOTIFICATION_EMAIL_PROVIDER=disabled
CUAC_NOTIFICATION_EMAIL_FROM=no-reply@staging.example.com
CUAC_NOTIFICATION_EMAIL_SMTP_REGION=cn-hangzhou
CUAC_NOTIFICATION_EMAIL_SMTP_USERNAME=no-reply@staging.example.com
CUAC_NOTIFICATION_EMAIL_SMTP_PASSWORD=
CUAC_NOTIFICATION_WORKER_POLL_MS=1000
CUAC_NOTIFICATION_WORKER_RECOVERY_MS=60000
CUAC_NOTIFICATION_WORKER_SUPERVISED=false
CUAC_NOTIFICATION_STAGING_ACCEPTED=false

# Application material snapshots and official school handoff.
# Keep delivery disabled until the fixed gateway contract and staging credentials are approved.
CUAC_MATERIAL_SNAPSHOT_ACTIVE_KEY_ID=
CUAC_MATERIAL_SNAPSHOT_KEYRING_JSON=
CUAC_SUBMISSION_DELIVERY_PROVIDER=disabled
CUAC_SUBMISSION_DELIVERY_ENDPOINT=
CUAC_SUBMISSION_DELIVERY_ALLOWED_HOST=
CUAC_SUBMISSION_DELIVERY_HMAC_SECRET=
CUAC_SUBMISSION_DELIVERY_WORKER_POLL_MS=1000
CUAC_SUBMISSION_DELIVERY_RECOVERY_MS=60000
CUAC_SUBMISSION_DELIVERY_TIMEOUT_MS=30000
CUAC_SUBMISSION_DELIVERY_WORKER_SUPERVISED=false
CUAC_SUBMISSION_DELIVERY_STAGING_ACCEPTED=false

# Agent safety
CUAC_AGENT_ENABLED=false
CUAC_AGENT_TOOL_GATEWAY_MODE=disabled
CUAC_AGENT_SANDBOX_MODE=disabled
CUAC_AGENT_DIRECT_DB_ACCESS=false

# Billing configuration. Minor units only; CNY 800.00 => 80000.
CUAC_APPLICATION_FEE_MINOR=80000
CUAC_SERVICE_FEE_MINOR=0
CUAC_BILLING_CURRENCY=CNY
# Enable test mode only for the controlled signed checkout-webhook-refund acceptance run.
CUAC_PAYMENT_MODE=disabled
CUAC_PAYMENT_PROVIDER=
CUAC_PAYMENT_GATEWAY_ENDPOINT=
CUAC_PAYMENT_GATEWAY_ALLOWED_HOST=
CUAC_PAYMENT_CHECKOUT_ALLOWED_HOST=
CUAC_PAYMENT_GATEWAY_HMAC_SECRET=
CUAC_PAYMENT_WEBHOOK_SECRET=
CUAC_PAYMENT_GATEWAY_TIMEOUT_MS=10000
CUAC_PAYMENT_WEBHOOK_MAX_SKEW_MS=300000
CUAC_PAYMENT_RECONCILIATION_POLL_MS=1000
CUAC_PAYMENT_RECONCILIATION_WORKER_SUPERVISED=false
CUAC_PAYMENT_STAGING_ACCEPTED=false

# Private student files. Enable only for the controlled Alibaba Cloud acceptance run.
CUAC_FILE_UPLOAD_ENABLED=false
ALIYUN_OSS_REGION=oss-cn-shanghai
ALIYUN_OSS_PRIVATE_BUCKET=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_OSS_KMS_KEY_ID=
CUAC_FILE_MAX_BYTES=26214400
CUAC_FILE_UPLOAD_TTL_SECONDS=900
CUAC_FILE_DOWNLOAD_TTL_SECONDS=60
CUAC_FILE_RETENTION_DAYS=365
CUAC_CLAMDSCAN_PATH=clamdscan
CUAC_FILE_WORKER_POLL_MS=1000
CUAC_FILE_WORKER_RECOVERY_MS=60000
CUAC_FILE_WORKER_RETENTION_MS=3600000
# Set true only when each control has current staging evidence.
CUAC_FILE_WORKER_SUPERVISED=false
CUAC_OSS_VERSIONING_CONFIRMED=false
CUAC_OSS_LIFECYCLE_CONFIRMED=false
CUAC_OSS_CORS_CONFIRMED=false
CUAC_FILE_STAGING_ACCEPTED=false

# Production-only migration approvals must remain false in staging.
CUAC_ALLOW_PRODUCTION_MIGRATION=false
CUAC_MIGRATION_RUNBOOK_ACK=false

# Hard offline gate; expected to fail while required integrations are missing.
CUAC_REQUIRE_PRODUCTION_READY=true
